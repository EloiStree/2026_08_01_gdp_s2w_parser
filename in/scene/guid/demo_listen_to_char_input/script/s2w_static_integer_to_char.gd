class_name S2WStaticIntegerToChar
extends Node


static func get_char_from_integer(integer:int)->String:
	## https://github.com/eloiStree/s2w
	if _char_from_integer.has(integer):
		return _char_from_integer[integer]
	return ""
	
static func get_integer_from_char(char:String)->int:
	if _integer_from_char.size() == 0:
		for key in _char_from_integer.keys():
			_integer_from_char[_char_from_integer[key]] = key
	## https://github.com/eloiStree/s2w
	if _integer_from_char.has(char):
		return _integer_from_char[char]
	return -1

